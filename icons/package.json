    "lodash.camelcase": "^4.3.0",
    "lodash.kebabcase": "^4.1.1",
    "lodash.upperfirst": "^4.3.1"
  },
  "devDependencies": {
    "cheerio": "1.2.0",
    "mini-svg-data-uri": "1.4.4",
    "style-dictionary": "5.4.0",
    "svgo": "4.0.1"
  }
}
