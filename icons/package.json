  "license": "UNLICENSED",
  "main": "dist/index.cjs.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "optimize": "svgo ./src/svg --config ./svgo.config.js",
