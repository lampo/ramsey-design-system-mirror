{
  "name": "ramsey-design-system",
  "main": "index.js",
  "repository": "https://github.com/lampo/ramsey-design-system",
  "author": "Ramsey Solutions",
  "license": "UNLICENSED",
  "private": true,
  "workspaces": [
    "components/*",
    "icons",
    "tokens",
    "common"
  ],
  "scripts": {
    "build": "lerna run build --stream",
    "build:no-icons": "lerna run build --stream --ignore @ramsey-design-system/icons",
    "build:watch": "lerna run watch --parallel",
    "build-storybook": "yarn storybook build -c .storybook/config/react",
    "build-storybook:vue": "yarn prebuild-storybook && yarn storybook build -c .storybook/config/vue",
    "format": "yarn run format:js && yarn run format:scss && yarn run format:prettier",
    "format:js": "yarn run lint:js --fix",
    "format:prettier": "prettier --write \"**/*.{js,jsx,scss,json,md}\"",
    "format:scss": "yarn run lint:scss --fix",
    "generate:freemarker-macro": "npx hygen freemarker-macro new --name",
    "generate:react-component": "npx hygen react-component new --name",
    "generate:vue-component": "npx hygen vue-component new --name",
    "lint": "yarn run lint:js && yarn run lint:scss",
    "lint:js": "eslint . --ext .js,.jsx",
    "lint:scss": "stylelint **/*.scss",
    "prebuild-storybook": "lerna run build",
    "precommit": "lint-staged",
    "prepare": "husky",
    "prerelease": "yarn run build",
    "prestart": "yarn run build",
    "release": "lerna version --yes --git-remote upstream && lerna publish from-package --yes",
    "release:fast": "lerna version --yes --git-remote upstream && lerna publish from-package --yes",
    "release:test": "lerna version --no-push --no-git-tag-version --no-commit-hooks",
    "start": "yarn storybook dev -c .storybook/config/react -p 1234",
    "start:all": "node_modules/@storybook/vue3/bin/index.js -c .storybook/config/vue -p 6007 --ci & node_modules/@storybook/react/bin/index.js -c .storybook/config/react -p 6006 --ci && fg",
    "start:vue": "yarn storybook dev -c .storybook/config/vue",
    "test": "jest"
  },
  "devDependencies": {
    "@babel/cli": "7.28.6",
    "@babel/core": "7.29.0",
    "@babel/eslint-parser": "7.28.6",
    "@babel/plugin-transform-runtime": "7.29.0",
    "@babel/preset-env": "7.29.2",
    "@babel/preset-react": "7.28.5",
    "@chromatic-com/storybook": "5.1.2",
    "@eslint/eslintrc": "3.3.5",
    "@rollup/plugin-babel": "7.0.0",
    "@rollup/plugin-commonjs": "29.0.2",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-replace": "6.0.3",
    "@rollup/plugin-typescript": "12.3.0",
    "@storybook/addon-a11y": "10.3.5",
    "@storybook/addon-docs": "10.3.5",
    "@storybook/react-vite": "10.3.5",
    "@storybook/vue3-vite": "10.3.5",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@testing-library/vue": "8.1.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "8.59.0",
    "@typescript-eslint/parser": "8.59.0",
    "@vitejs/plugin-react": "6.0.1",
    "@vitejs/plugin-vue": "6.0.6",
    "@vue/compiler-sfc": "3.5.32",
    "@vue/vue3-jest": "29.2.6",
    "babel-jest": "30.3.0",
    "chroma-js": "3.2.0",
    "eslint": "10.2.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-storybook": "10.3.5",
    "globals": "17.5.0",
    "husky": "9.1.7",
    "jest": "30.3.0",
    "jest-environment-jsdom": "30.3.0",
    "lerna": "9.0.7",
    "lint-staged": "16.4.0",
    "lodash": "4.18.1",
    "npm-run-all2": "8.0.4",
    "postcss": "8.5.10",
    "postcss-scss": "4.0.9",
    "prettier": "3.8.3",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-is": "19.2.5",
    "rollup": "4.60.2",
    "rollup-plugin-vue": "6.0.0",
    "sass": "1.99.0",
    "storybook": "10.3.5",
    "strip-ansi": "7.2.0",
    "stylelint": "17.8.0",
    "stylelint-config-prettier": "9.0.5",
    "stylelint-config-sass-guidelines": "13.0.0",
    "stylelint-order": "8.1.1",
    "stylelint-scss": "7.0.0",
    "ts-jest": "29.4.9",
    "typescript": "6.0.3",
    "vite": "8.0.9",
    "vue": "3.5.32"
  },
  "browserslist": [
    ">0.25%",
    "safari >=9",
    "not ie < 11",
    "not op_mini all"
  ]
}
